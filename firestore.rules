rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn()
          && currentUser().data.role == 'owner'
          && currentUser().data.isActive == true;
    }

    function ownerTenantId() {
      return currentUser().data.tenantId;
    }

    function isActiveTenantMember(tenantId) {
      return signedIn()
          && currentUser().data.tenantId == tenantId
          && currentUser().data.isActive == true;
    }

    match /users/{userId} {
      allow read: if signedIn()
                  && (
                    request.auth.uid == userId
                    || (isOwner() && resource.data.tenantId == ownerTenantId())
                  );

      allow create: if isOwner()
                    && request.resource.data.tenantId == ownerTenantId()
                    && request.resource.data.role in ['admin', 'manager', 'cashier']
                    && request.resource.data.isActive == true;

      // Owners can manage users inside their own tenant, but cannot create
      // another owner or move a user to a different tenant.
      allow update: if (
                      isOwner()
                      && resource.data.tenantId == ownerTenantId()
                      && request.resource.data.tenantId == ownerTenantId()
                      && request.resource.data.role in ['admin', 'manager', 'cashier']
                    )
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.tenantId == resource.data.tenantId
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.isActive == resource.data.isActive
                    );

      allow delete: if isOwner()
                    && request.auth.uid != userId
                    && resource.data.tenantId == ownerTenantId();

      match /sessions/{deviceId} {
        allow read: if signedIn()
                    && (
                      request.auth.uid == userId
                      || (isOwner() &&
                          get(/databases/$(database)/documents/users/$(userId)).data.tenantId == ownerTenantId())
                    );

        allow create, update: if signedIn() && request.auth.uid == userId;

        allow delete: if signedIn()
                      && (
                        request.auth.uid == userId
                        || (isOwner() &&
                            get(/databases/$(database)/documents/users/$(userId)).data.tenantId == ownerTenantId())
                      );
      }
    }

    // All tenant business data is isolated by the authenticated user's
    // tenantId. The sync adapter writes to this exact hierarchy:
    // tenants/{tenantId}/{collection}/{documentId}
    match /tenants/{tenantId}/{collection}/{documentId} {
      allow read, create, update, delete: if isActiveTenantMember(tenantId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
