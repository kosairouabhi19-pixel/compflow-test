rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn()
          && currentUser().data.role == 'owner'
          && currentUser().data.isActive == true;
    }

    function ownerTenantId() {
      return currentUser().data.tenantId;
    }

    match /users/{userId} {
      allow read: if signedIn()
                  && (
                    request.auth.uid == userId
                    || (isOwner() && resource.data.tenantId == ownerTenantId())
                  );

      allow create: if isOwner()
                    && request.resource.data.tenantId == ownerTenantId()
                    && request.resource.data.role in ['admin', 'manager', 'cashier']
                    && request.resource.data.isActive == true;

      allow update: if (
                      isOwner()
                      && resource.data.tenantId == ownerTenantId()
                      && request.resource.data.tenantId == ownerTenantId()
                      && request.resource.data.role in ['admin', 'manager', 'cashier', 'owner']
                    )
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.tenantId == resource.data.tenantId
                    );

      allow delete: if isOwner()
                    && request.auth.uid != userId
                    && resource.data.tenantId == ownerTenantId();

      match /sessions/{deviceId} {
        // A user can see their own sessions. The owner can also inspect
        // sessions belonging to employees in the same tenant.
        allow read: if signedIn()
                    && (
                      request.auth.uid == userId
                      || (isOwner() &&
                          get(/databases/$(database)/documents/users/$(userId)).data.tenantId == ownerTenantId())
                    );

        // Session writes are limited to the authenticated account itself.
        // The app uses these documents to enforce the MVP device limit.
        allow create, update: if signedIn() && request.auth.uid == userId;

        // The user can release their own session. The owner can also force
        // a session logout for an employee in the same tenant.
        allow delete: if signedIn()
                      && (
                        request.auth.uid == userId
                        || (isOwner() &&
                            get(/databases/$(database)/documents/users/$(userId)).data.tenantId == ownerTenantId())
                      );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
